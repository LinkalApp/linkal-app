<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.BusinessProfileActivity">

    <!-- Contenido principal -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera: avatar + nombre -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="36dp"
                    android:paddingBottom="20dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <!-- Avatar circular con iniciales -->
                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginBottom="14dp">

                        <View
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_avatar_circle"/>

                        <TextView
                            android:id="@+id/txtInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary"/>
                    </FrameLayout>

                    <!-- Nombre + badge verificado centrados -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/txtName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark"/>

                        <ImageView
                            android:id="@+id/imgVerifiedBadge"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_verified_badge"
                            android:contentDescription="Verificado"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <!-- Categoría como subtítulo -->
                    <TextView
                        android:id="@+id/txtCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/neutral_medium"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"/>

                    <!-- Media de valoraciones (5 links) -->
                    <LinearLayout
                        android:id="@+id/rowRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:layout_marginTop="12dp">

                        <ImageView android:id="@+id/link1"
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/ic_nav_matches"
                            android:contentDescription="@null"/>
                        <ImageView android:id="@+id/link2"
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/ic_nav_matches"
                            android:contentDescription="@null"/>
                        <ImageView android:id="@+id/link3"
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/ic_nav_matches"
                            android:contentDescription="@null"/>
                        <ImageView android:id="@+id/link4"
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/ic_nav_matches"
                            android:contentDescription="@null"/>
                        <ImageView android:id="@+id/link5"
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_nav_matches"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/txtRatingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textSize="18sp"
                            android:textColor="@color/neutral_medium"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Menú de 3 puntos -->
                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/neutral_dark"
                    android:contentDescription="Opciones"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/neutral_light"/>

            <!-- Sección: Sobre nosotros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sobre nosotros"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/neutral_light"/>

            <!-- Sección: Datos de contacto  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos de contacto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="12dp"/>

                <!-- Dirección -->
                <LinearLayout
                    android:id="@+id/rowAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Dirección"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/neutral_dark"/>
                </LinearLayout>

                <!-- Provincia -->
                <LinearLayout
                    android:id="@+id/rowProvince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Provincia"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtProvince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/neutral_dark"/>
                </LinearLayout>

                <!-- Web -->
                <LinearLayout
                    android:id="@+id/rowWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Web"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtWebsite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/secondary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Teléfono -->
                <LinearLayout
                    android:id="@+id/rowPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Teléfono"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/neutral_dark"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Error -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de navegación -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/nav_business_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"/>

</LinearLayout>