<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.CreateCampaignActivity">

    <!-- Cabecera con back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/neutral_dark"
            android:contentDescription="@string/goBack"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txtNewCampaign"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Formulario -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Título * -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleNameCampaign"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintNameCampaign"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleDescription"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintDescriptionCampaign"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:layout_marginBottom="20dp"/>

            <!-- Objetivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleObjective"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtObjective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintObjective"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- Requisitos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleRequirements"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintRequirements"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:layout_marginBottom="20dp"/>

            <!-- Recompensa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleReward"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintReward"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <!-- Error -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón guardar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Crear campaña"
            android:textSize="16sp"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</LinearLayout>