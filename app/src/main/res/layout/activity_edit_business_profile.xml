<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.EditBusinessProfileActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/goBack"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/optionEditProfile"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:paddingStart="8dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/save"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!--DATOS DEL NEGOCIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/businessData"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_medium"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"/>

            <!-- Nombre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titleNameBusiness"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textPersonName"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintNameBusiness"
                android:layout_marginBottom="16dp"/>

            <!-- Teléfono -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titlePhoneNumber"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="phone"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:hint="Ej. 666000000"
                android:layout_marginBottom="16dp"/>

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titleDescription"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintBusinessDescription"
                android:layout_marginBottom="24dp"/>

            <!--UBICACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleLocation"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_medium"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"/>

            <!-- Dirección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txtDirection"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textPostalAddress"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintDirection"
                android:layout_marginBottom="16dp"/>

            <!-- Provincia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txtProvince"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/edtProvince"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="16sp"/>

            <!-- ONLINE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_medium"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"/>

            <!-- Página web -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txtWebPage"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtWebsite"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textWebEmailAddress"
                android:textSize="14sp"
                android:textColor="@color/neutral_dark"
                android:hint="https://miempresa.com"
                android:layout_marginBottom="24dp"/>

            <!-- Error -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>