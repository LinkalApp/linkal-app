<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.EditCampaignActivity">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/neutral_dark"
            android:contentDescription="Volver"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar campaña"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:paddingStart="8dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Guardar"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

    <!-- Formulario desplazable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleNameCampaign"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintNameCampaign"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleDescription"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintDescriptionCampaign"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:layout_marginBottom="20dp"/>

            <!-- Objetivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleObjective"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtObjective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintObjective"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- Requisitos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleRequirements"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintRequirements"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:layout_marginBottom="20dp"/>

            <!-- Recompensa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleReward"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/edtReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/neutral_dark"
                android:hint="@string/hintReward"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- Estado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleStatusCampaign"
                android:textSize="13sp"
                android:textColor="@color/neutral_medium"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="20dp"/>

            <!-- Error -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>