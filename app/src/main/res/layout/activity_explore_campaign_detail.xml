<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activities.ExploreCampaignDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera: título + estado + botón volver -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/goBack"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark"/>

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:textColor="@color/secondary"
                            android:background="@drawable/ic_verified_badge"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCreationDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_medium"/>

                </LinearLayout>
            </FrameLayout>

            <!-- Datos del negocio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="20dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txtBusiness"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/neutral_medium"
                    android:layout_marginBottom="12dp"/>

                <!-- Avatar + nombre + categoría -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/txtBusinessInitials"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:background="@drawable/bg_avatar_circle"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/txtBusinessName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/neutral_dark"/>

                            <ImageView
                                android:id="@+id/imgBusinessVerified"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_verified_badge"
                                android:visibility="gone"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtBusinessCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/neutral_medium"
                            android:layout_marginTop="2dp"
                            android:visibility="gone"/>

                        <!-- Media de valoraciones (5 links) -->
                        <LinearLayout
                            android:id="@+id/rowRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:layout_marginTop="12dp">

                            <ImageView android:id="@+id/link1"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="3dp"
                                android:src="@drawable/ic_nav_matches"
                                android:contentDescription="@null"/>
                            <ImageView android:id="@+id/link2"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="3dp"
                                android:src="@drawable/ic_nav_matches"
                                android:contentDescription="@null"/>
                            <ImageView android:id="@+id/link3"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="3dp"
                                android:src="@drawable/ic_nav_matches"
                                android:contentDescription="@null"/>
                            <ImageView android:id="@+id/link4"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="3dp"
                                android:src="@drawable/ic_nav_matches"
                                android:contentDescription="@null"/>
                            <ImageView android:id="@+id/link5"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_nav_matches"
                                android:contentDescription="@null"/>

                            <TextView
                                android:id="@+id/txtRatingValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="16sp"
                                android:textColor="@color/neutral_medium"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Descripción del negocio -->
                <TextView
                    android:id="@+id/txtBusinessDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"/>

                <!-- Provincia, web y dirección -->
                <LinearLayout
                    android:id="@+id/rowBusinessProvince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/txtProvince"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtBusinessProvince"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_dark"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBusinessWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Web"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtBusinessWebsite"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/links"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBusinessAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/txtDirection"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_medium"/>

                    <TextView
                        android:id="@+id/txtBusinessAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/neutral_dark"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Datos de la campaña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="20dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titleDetailCampaign"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/neutral_medium"
                    android:layout_marginBottom="12dp"/>

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titleDescription"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="14dp"/>

                <!-- Objetivo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titleObjective"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtObjective"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="14dp"/>

                <!-- Requisitos -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titleRequirements"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="14dp"/>

                <!-- Recompensa -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titleReward"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtReward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnRateBusiness"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_gravity="center"
                android:text="⭐ Valorar comercio"
                android:textColor="@color/black"
                android:backgroundTint="#FBC8BA"
                android:padding="14dp"
                android:textSize="16sp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnInterested"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_gravity="center"
                android:text="@string/txtInterested"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:textSize="16sp" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>