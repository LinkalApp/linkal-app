<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.ForgotPasswordActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- LOGO -->
            <ImageView
                android:layout_width="181dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:contentDescription="@string/linkal"
                android:src="@drawable/ic_linkal" />

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/forgotPassword"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:layout_marginTop="8dp" />

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:fontFamily="@font/poppins"
                android:text="@string/forgotPasswordSubtitle"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginLeft="5dp"
                android:text="Email"
                android:textColor="#2D3142"
                android:textSize="18sp"
                android:fontFamily="@font/poppins" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="hola@xyz.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textSize="16sp"
                android:textColor="#2D3142"
                android:textColorHint="#A7ADB8"
                android:fontFamily="@font/poppins_regular" />

            <!-- ERROR -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- BOTÓN ENVIAR -->
            <Button
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_rounded"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/sendCode"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- VOLVER AL LOGIN -->
            <TextView
                android:id="@+id/txtBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins"
                android:text="@string/backToLogin"
                android:textColor="#5C6BC0"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
