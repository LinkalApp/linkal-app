<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Linkal" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Surface -->
        <item name="colorSurface">@color/neutral_light</item>
        <item name="colorOnSurface">@color/neutral_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Text -->
        <item name="android:textColor">@color/neutral_dark</item>

        <!-- Sin animaciones de transición entre Activities -->
        <item name="android:windowAnimationStyle">@null</item>

    </style>

    <!-- Main theme -->
    <style name="Theme.Linkal" parent="Base.Theme.Linkal" />

</resources>